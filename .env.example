# Copy to .env and fill in real values. Never commit .env.

# local | test | docker. INSECURE_MODE is only allowed when ENV=test.
ENV=local

# Signs JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

DATABASE_URL=sqlite:///./securevault.db

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Deliberately disables selected security controls for the test suite demo.
# Must stay false outside ENV=test.
INSECURE_MODE=false
